####### Compile

main.o: main.cpp window.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o main.o main.cpp

functions.o: functions.cpp functions.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o functions.o functions.cpp

chebyshev_approximation.o: chebyshev_approximation.cpp chebyshev_approximation.h \
		functions.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o chebyshev_approximation.o chebyshev_approximation.cpp

hermite_spline_approximation.o: hermite_spline_approximation.cpp hermite_spline_approximation.h \
		functions.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o hermite_spline_approximation.o hermite_spline_approximation.cpp

parabolic_approximation.o: parabolic_approximation.cpp parabolic_approximation.h \
		functions.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o parabolic_approximation.o parabolic_approximation.cpp

window.o: window.cpp window.h \
		functions.h \
		chebyshev_approximation.h \
		hermite_spline_approximation.h \
		parabolic_approximation.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o window.o window.cpp

