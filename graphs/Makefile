	@test -d $(DISTDIR) || mkdir -p $(DISTDIR)
	$(COPY_FILE) --parents $(DIST) $(DISTDIR)/
	$(COPY_FILE) --parents /nix/store/sg43zvnkh9hfscqvlqir3pcdxl0kd00l-qtbase-5.15.18-dev/mkspecs/features/data/dummy.cpp $(DISTDIR)/
	$(COPY_FILE) --parents functions.h chebyshev_approximation.h bessel_spline_approximation.h window.h $(DISTDIR)/
	$(COPY_FILE) --parents main.cpp functions.cpp chebyshev_approximation.cpp bessel_spline_approximation.cpp window.cpp $(DISTDIR)/


