qmake: FORCE
	@$(QMAKE) -o Makefile app.pro

qmake_all: FORCE


all: Makefile build/bin/app

dist: distdir FORCE
	(cd `dirname $(DISTDIR)` && $(TAR) $(DISTNAME).tar $(DISTNAME) && $(COMPRESS) $(DISTNAME).tar) && $(MOVE) `dirname $(DISTDIR)`/$(DISTNAME).tar.gz . && $(DEL_FILE) -r $(DISTDIR)

distdir: FORCE
	@test -d $(DISTDIR) || mkdir -p $(DISTDIR)
	$(COPY_FILE) --parents $(DIST) $(DISTDIR)/
	$(COPY_FILE) --parents /usr/lib/x86_64-linux-gnu/qt5/mkspecs/features/data/dummy.cpp $(DISTDIR)/
	$(COPY_FILE) --parents core/Approximation.h gui/GraphWidget.h gui/3DRender.h gui/Data.h gui/InfoDisplay.h model/Model.h interface/MainWindow.h resources/Storage.h utils/Geometry.h utils/CommonDefs.h $(DISTDIR)/
	$(COPY_FILE) --parents core/Approximation.cpp gui/GraphWidget.cpp gui/3DRender.cpp gui/Data.cpp gui/InfoDisplay.cpp model/Model.cpp interface/MainWindow.cpp interface/main.cpp resources/Storage.cpp utils/Geometry.cpp $(DISTDIR)/


